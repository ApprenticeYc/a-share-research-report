: [{"statement": "E类中报3/6/12个月收益0.72%、1.41%、3.64%，同期基准0.38%、0.82%、0.55%。", "pdf_page": 7, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "期末资产9.25亿元、回购融资1.45亿元，债券金额在同页列示。", "pdf_page": 14, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "期末净资产7.78亿元。", "pdf_page": 15, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "债券占净资产118.22%，前五债券占净资产15.16%。", "pdf_page": 43, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "短期债券评级表全部为未评级，金额3514.04万元，注明为企业短期融资券和企业超短期融资债券。", "pdf_page": 34, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "长期债券评级表为AAA 2.81亿元、AAA以下0、未评级6.05亿元；未评级内含政府类债券及公司债、普通金融债和中票。", "pdf_page": 35, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "利率风险敞口表列示1-5年债券5.81亿元、5年以上债券2.51亿元。", "pdf_page": 37, "source_sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1"}, {"statement": "E类不收取申购费；赎回0-6日1.5%、7日及以上0%。", "pdf_page": 4, "source_sha256": "295888098ec1ea10860694576b3dc7710f8cd7a64f8f895ce59ff4f9b30e5300"}], "return_sources": ["管理人自述：配置信用债、运用杠杆套息，并参与长端利率债交易。", "可计算事实：2026年上半年母基金债券投资收益1200.07万元、公允价值变动收益155.18万元、回购利息支出83.98万元；债券买卖价差收益271.20万元。", "管理人策略叙述与可计算损益分开记录；期末回购融资占净资产18.63%，余额本身不能证明已实现正息差。"], "risk": {"duration": {"assessment": "中等偏高利率敏感性", "evidence": "期末债券市值中1-5年约5.81亿元、5年以上约2.51亿元；利率平行上移/下移25bp对净资产影响约-0.893%/+0.911%，精确久期未披露。", "exact_years": null}, "leverage": {"assessment": "期末卖出回购款1.45亿元；这是期末融资余额，不能证明已实现正息差。", "asset_to_nav_pct": 118.78, "repo_financing_to_nav_pct": 18.63}, "credit_concentration": {"assessment": "评级表覆盖全部债券市值：AAA 30.49%、AAA以下0、未评级69.51%。未评级约6.40亿元，包含政府债、政策金融债、地方政府债，也包含企业债、普通金融债和中票；无法从该表复核其中信用资产的等效质量。前五债券占净资产15.16%。", "rating_coverage_pct": 100.0, "top5_pct_nav": 15.16}, "equity_exposure": {"assessment": "不投资股票；允许可分离交易可转债纯债部分。期末无股票和转债。", "actual_pct": 0.0, "convertible_bond_exposure_pct": 0.0}}, "terms": {"minimum_holding_days": 0, "redemption_fee_note": "无最低持有期锁定；持有0-6日赎回费1.5%，持有7日及以上赎回费0%。", "settlement_note": "T日有效申请通常T+1确认，T+2起可查询；赎回生效后T+7日内支付，巨额赎回或异常情形可延缓。"}, "fit": {"suitable": ["理解信用债、银行资本工具、长端利率、回购融资和机构集中风险", "能接受普通开放式申赎以及不足7日的赎回费"], "unsuitable": ["要求信用资产等级分布可以从评级表完整复核", "对机构持有人集中或单一投资者集中敏感", "把期末回购余额直接理解为已实现正息差"]}, "unknowns": ["未评级债券中信用资产的等效评级或质量分布", "精确久期", "统一单笔最低赎回份额", "销售渠道额度及实际到账日"], "style_exclusions": {"credit_quality": "未评级债券占69.51%，其中包含显著信用资产，但披露不足以复核等效信用质量，故status=partial且risk_verified=false。"}, "source_documents": [{"kind": "report", "title": "华泰紫金智盈债券型证券投资基金2026年中期报告", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202608311828778371_1.pdf", "sha256": "18c378ca6fb3428cd20adab5fcd0cbc619090f25be6c8ceed0344a2a3fbcccf1", "page_count": 51, "published_at": "2026-08-31", "source_role": "collected_material"}, {"kind": "key_information", "title": "华泰紫金智盈债券型证券投资基金基金产品资料概要更新", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202602071819820358_1.pdf", "sha256": "295888098ec1ea10860694576b3dc7710f8cd7a64f8f895ce59ff4f9b30e5300", "page_count": 5, "published_at": "2026-02-07", "source_role": "collected_material"}, {"kind": "prospectus", "title": "华泰紫金智盈债券型证券投资基金招募说明书(更新)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202602071819820506_1.pdf", "sha256": "caee8803abf2bbeb5adda291f04d92dfacf96e4a43a0f919e14b0fdfb85b698b", "page_count": 110, "published_at": "2026-02-07", "source_role": "collected_material"}]}, "assessment": {"share_id": "021506", "product_key": "mother:华泰紫金智盈债券型证券投资基金", "official_mother_id": "华泰紫金智盈债券型证券投资基金", "representative_share_id": "021506", "queue": "research_candidates", "base_gate_reasons": ["evidence_status_not_verified", "market_data_is_dated_requires_disclosure_calendar_review", "metrics_behind_known_nav_date", "metrics_last_date_stale", "risk_verified_required"], "formal_eligible_horizons_months": []}, "holding_scenarios": {"windows": {"1"