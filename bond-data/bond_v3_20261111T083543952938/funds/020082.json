": "\u003e=30", "rate_pct": 0.0}]}, "fee_refs": [], "findings": [{"statement": "D类截至2026-06-30过去3/6/12个月收益0.81%/1.80%/1.67%，同期信用债基准1.01%/2.05%/2.45%。", "pdf_page": 8, "source_sha256": "347c237b1d696b3ad68d034c274fc9a7969d93fb919d583c38badc927e882075"}, {"statement": "期末总资产200.576亿元、净资产166.013亿元、回购融资33.185亿元，总资产/净资产120.82%。", "pdf_page": 16, "source_sha256": "347c237b1d696b3ad68d034c274fc9a7969d93fb919d583c38badc927e882075"}, {"statement": "债券119.12%净资产，金融债85.62%；前五合计18.16%，ABS约0.42%。", "pdf_page": 44, "source_sha256": "347c237b1d696b3ad68d034c274fc9a7969d93fb919d583c38badc927e882075"}, {"statement": "利率平移-25bp/+25bp对净资产影响约+1.55%/-1.49%。", "pdf_page": 42, "source_sha256": "347c237b1d696b3ad68d034c274fc9a7969d93fb919d583c38badc927e882075"}, {"statement": "D类机构持有96.71%，基金经理未持有D类但持有A类10万至50万份；报告期无单一投资者超过20%。", "pdf_page": 47, "source_sha256": "347c237b1d696b3ad68d034c274fc9a7969d93fb919d583c38badc927e882075"}, {"statement": "D类首档标准申购费0.80%，满30日赎回费为0；管理费0.35%、托管费0.10%。", "pdf_page": 3, "source_sha256": "43b47f5cf56aa355980d8946783ad456c687b7d391b1a9df8776e2755496fcaa"}], "return_sources": ["上半年D类收益1.80%，同期中债-优选投资级信用债财富指数2.05%，主动收益-0.25个百分点；3个月和12个月窗口也分别落后0.20和0.78个百分点。", "管理人称一季度久期在基准附近至偏低，4月后提高至基准以上，并将部分中间期限利率债置换成长端和超长端，同时配置二级资本债、永续债并用国债期货管理久期。", "管理人披露同期基准2.05%可拆为静态收益0.93%和资本利得1.12%；这是基准归因，不等同基金自身的精确收益拆分。回购融资19.99%净资产会同步放大息差与波动。"], "risk": {"duration": {"assessment": "信用债基准附近至偏长久期，并增配长端和超长端利率债", "evidence": "利率下降/上升25bp对净资产影响约+1.55%/-1.49%；管理人还使用国债期货管理久期。", "exact_years": null}, "leverage": {"assessment": "期末回购融资较高、债券119.12%净资产，杠杆是收益和流动性风险的重要来源。", "asset_to_nav_pct": 120.82, "repo_financing_to_nav_pct": 19.99}, "credit_concentration": {"assessment": "金融债85.62%净资产，其中国策行仅6.20%；中票12.78%、企业债3.61%。前五合计18.16%，四只为银行永续债、二级资本债或普通金融债，银行业和次级属性集中。", "top5_pct_nav": 18.16}, "equity_exposure": {"assessment": "期末及报告期无股票，期末无普通转债；合同不直接投资股票和普通可转债，但明确允许可分离交易可转债纯债部分。期末ABS约0.42%净资产，不能把当前转债为零误写为禁止所有相关纯债。", "actual_pct": 0.0, "convertible_bond_exposure_pct": 0.0}}, "terms": {"minimum_holding_days": 0, "redemption_fee_note": "没有合同锁定期；不足7日1.50%，7至29日0.75%，持有满30日为0。", "settlement_note": "正常T日申请、T+1确认、T+2可查询；2026-08-29招募说明书仅写赎回生效后在法律法规规定期限内支付，未披露固定T+n，实际到账也受渠道和银行清算影响。"}, "fit": {"suitable": ["需要投资级信用债、能接受银行金融债与约20%回购融资", "理解D类有前端申购费并计划至少持有30日"], "unsuitable": ["要求近期稳定跑赢信用债基准", "不能承受银行资本工具、ABS、利率和杠杆风险", "必须在合同中看到固定T+n赎回付款上限"]}, "unknowns": ["当前招募说明书未给赎回款固定T+n支付上限，仅写法律法规规定期限内，因此条款维度保持未完全核实", "精确组合久期、国债期货期间头寸和银行资本债逐券内部评级未完整披露", "中报不列1个月和24个月窗口", "研究日平台可买性、渠道折扣、限额和实际到账未核"], "source_documents": [{"kind": "report", "title": "易方达信用债债券型证券投资基金2026年第3季度报告", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202610271830958585_1.pdf", "sha256": "88f7f8e609c11e4be83222a517addb181524f0555272435525a0141a2af43d2c", "page_count": 16, "published_at": "2026-10-27", "source_role": "collected_material"}, {"kind": "key_information", "title": "易方达信用债债券型证券投资基金(易方达信用债债券D)基金产品资料概要更新", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202608211828235000_1.pdf", "sha256": "43b47f5cf56aa355980d8946783ad456c687b7d391b1a9df8776e2755496fcaa", "page_count": 4, "published_at": "2026-08-21", "source_role": "collected_material"}, {"kind": "prospectus", "title": "易方达信用债债券型证券投资基金更新的招募说明书", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202608291828675794_1.pdf", "sha256": "c58ae159f2df724a1d11b82281d5621262f791d8ed912fdd2eac4b1941436041", "page_count": 128, "published_at": "2026-08-29", "source_role": "collected_material"}]}, "assessment": {"share_id": "020082", "product_key": "mother:易方达信用债债券型证券投资基金", "official_mother_id": "易方达信用债债券型证券投资基金", "representative_share_id": "020082", "queue": "research_candidates", "base_gate_reasons": ["evidence_status_not_verified", "market_data_is_dated_requires_disclosure_calendar_review", "risk_verified_required", "terms_verified_required"], "formal_eligible_horizons_months": []}, "holding_scenarios": {"windows": {"1": {"months": 1, "ready": false, "fee_status": "unknown", "net_return": null, "as_of": "2026-11-11", "fee_schedule_as_of": "2026-11-11", "market_data_end":