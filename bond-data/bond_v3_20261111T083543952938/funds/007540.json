unt": "\u003e=5百万元"}], "redemption": [{"holding_days": "0-6", "rate_pct": 1.5}, {"holding_days": "7-29", "rate_pct": 0.05}, {"holding_days": "\u003e=30", "rate_pct": 0.0}]}, "fee_refs": [], "findings": [{"statement": "A类截至2026-06-30过去3/6/12个月收益3.24%/4.08%/-2.17%，同期中债总指数全价收益0.49%/0.63%/-1.07%。", "pdf_page": 7, "source_sha256": "541b5e7e4dc5719140ce980469df4f1f8dea6b3c828ce548b70d458b0b8ae652"}, {"statement": "期末总资产166.656亿元、净资产131.159亿元、回购融资33.956亿元，总资产/净资产127.06%。", "pdf_page": 17, "source_sha256": "541b5e7e4dc5719140ce980469df4f1f8dea6b3c828ce548b70d458b0b8ae652"}, {"statement": "债券126.16%净资产，其中国债107.58%、政策性金融债18.58%；前五只国债合计92.79%。", "pdf_page": 38, "source_sha256": "541b5e7e4dc5719140ce980469df4f1f8dea6b3c828ce548b70d458b0b8ae652"}, {"statement": "利率平移-25bp/+25bp对净资产影响约+5.59%/-5.28%，利率债仍可能出现大幅净值波动。", "pdf_page": 36, "source_sha256": "541b5e7e4dc5719140ce980469df4f1f8dea6b3c828ce548b70d458b0b8ae652"}, {"statement": "A类机构持有55.60%，基金经理持有A类10万至50万份；报告期无单一投资者超过20%。", "pdf_page": 41, "source_sha256": "541b5e7e4dc5719140ce980469df4f1f8dea6b3c828ce548b70d458b0b8ae652"}, {"statement": "A类首档标准申购费0.80%，满30日赎回费为0；管理费0.30%、托管费0.08%。", "pdf_page": 3, "source_sha256": "48d8e24431b18740d3a4d01085acb7c81a33f262df48da2a1ee83219a7996583"}], "return_sources": ["上半年A类收益4.08%，同期中债总指数全价收益0.63%，主动收益3.45个百分点；管理人报告称减持中期利率债、提高超长债并兼顾国债与国开债。", "半年利润表债券投资收益4,706.64万元、公允价值变动收益4.0805亿元，收益以债券估值上涨为主，符合长久期在利率下行中的放大效应。", "期末回购融资为净资产25.89%，说明利率敞口杠杆化；它可能放大涨跌，但不能由期末余额推定半年净融资贡献。过去一年实际落后披露基准1.10个百分点。"], "risk": {"duration": {"assessment": "超长久期利率债风险突出", "evidence": "管理人明确提高超长债比例；利率下降/上升25bp对净资产影响约+5.59%/-5.28%，精确久期未披露。", "exact_years": null}, "leverage": {"assessment": "期末回购融资较高、债券126.16%净资产，接近以杠杆放大超长利率债敞口的组合。", "asset_to_nav_pct": 127.06, "repo_financing_to_nav_pct": 25.89}, "credit_concentration": {"assessment": "国债107.58%、政策性金融债18.58%净资产，信用风险较低；前五只国债合计92.79%，证券和久期集中度极高。", "top5_pct_nav": 92.79}, "equity_exposure": {"assessment": "合同明确不投股票、权证、企业债、公司债、中票、短融、可转债和可交换债；期末与报告期无股票，期末无转债、ABS和国债期货。", "actual_pct": 0.0, "convertible_bond_exposure_pct": 0.0}}, "terms": {"minimum_holding_days": 0, "redemption_fee_note": "没有合同锁定期；不足7日1.50%，7至29日0.05%，持有满30日为0。", "settlement_note": "正常T日申请、T+1确认、T+2可查询；赎回款在T+7日内支付，实际到账受渠道和银行清算影响。"}, "fit": {"suitable": ["明确需要国债和政策性金融债并能承受超长久期波动", "理解回购杠杆会放大上涨和下跌且计划持有至少30日"], "unsuitable": ["把利率债当作无回撤现金工具", "不能承受25bp利率变动对应约5%以上净值冲击或高回购融资", "需要资产和久期高度分散"]}, "unknowns": ["精确组合久期和关键国债剩余期限汇总未披露", "中报不列1个月和24个月窗口", "研究日平台可买性、折扣、限额和实际到账未核"], "style_exclusions": {"liquid": "可赎回不等于本金稳定；超长利率敏感度不适合短期用款的流动性优先候选。", "low_drawdown": "报告期末利率上行25bp情景约对应5.28%净值损失，超长久期叠加融资与低回撤目标不适配。"}, "source_documents": [{"kind": "report", "title": "华泰保兴安悦债券型证券投资基金2026年第3季度报告", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202610271830983609_1.pdf", "sha256": "40ef4050bce79e148c7225d0d7806124eaa2a8ff348d262712527d8975f1f938", "page_count": 12, "published_at": "2026-10-27", "source_role": "collected_material"}, {"kind": "key_information", "title": "华泰保兴安悦债券型证券投资基金基金产品资料概要更新(2026年第1号)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202605291822990505_1.pdf", "sha256": "48d8e24431b18740d3a4d01085acb7c81a33f262df48da2a1ee83219a7996583", "page_count": 5, "published_at": "2026-05-29", "source_role": "collected_material"}, {"kind": "prospectus", "title": "华泰保兴安悦债券型证券投资基金招募说明书更新(2026年第1号)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202605291822990603_1.pdf", "sha256": "c4227339827ce95894559b9a9e3b2c45da41923dd8bf44fadd47b3f215a56734", "page_count": 144, "published_at": "2026-05-29", "source_role": "collected_material"}]}, "assessment": {"share_id": "007540", "product_key": "mother:华泰保兴安悦债券型证券投资基金", "official_mother_id": "华泰保兴安悦债券型证券投资基金", "representative_share_id": "007540", "queue": "research_candidates", "base_gate_reasons": ["evidence_status_not_verified", "market_data_is_dated_requires_disclosure_calendar_review", "risk_verified_required"], "formal_eligible_horizons_months": []}, "holding_scenarios": {"windows": {"1": {"months": 1, "ready": false, "fee_status": "unknown", "ne