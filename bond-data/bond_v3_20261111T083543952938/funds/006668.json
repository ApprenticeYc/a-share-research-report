0.1}, {"holding_days": "\u003e=30", "rate_pct": 0.0}]}, "fee_refs": [], "findings": [{"statement": "A类过去3/6/12个月净值增长率分别为0.72%、1.29%、1.63%。", "pdf_page": 7, "source_sha256": "43770c03c889c62b59129e1e22ad955b3c2345390160e95ce1a08402dcb6e5b5"}, {"statement": "期末资产108.532亿元、净资产85.606亿元、卖出回购款22.285亿元。", "pdf_page": 22, "source_sha256": "43770c03c889c62b59129e1e22ad955b3c2345390160e95ce1a08402dcb6e5b5"}, {"statement": "银行间回购融资约19.98亿元，质押券包含银行资本债和产业中票。", "pdf_page": 38, "source_sha256": "43770c03c889c62b59129e1e22ad955b3c2345390160e95ce1a08402dcb6e5b5"}, {"statement": "债券占净资产125.41%，前五大合计12.21%，其中四只为银行二级资本债。", "pdf_page": 44, "source_sha256": "43770c03c889c62b59129e1e22ad955b3c2345390160e95ce1a08402dcb6e5b5"}, {"statement": "张海静于2026-01-29从基金经理助理转任基金经理。", "pdf_page": 19, "source_sha256": "43770c03c889c62b59129e1e22ad955b3c2345390160e95ce1a08402dcb6e5b5"}, {"statement": "A类持有不足7日赎回费1.50%，满30日为0。", "pdf_page": 3, "source_sha256": "8efb079a271ba45e396b71209e62f4120647f145b6f589a4033392f4c380befd"}], "return_sources": ["银行二级资本债、中票和企业债的票息与信用利差是主要收益来源。", "期末回购融资约26.03%净资产、债券仓位125.41%，杠杆套息是重要收益来源，也显著放大利率、信用和流动性风险。", "中短久期配置和主动久期调整提供利率波动收益；精确久期未披露。"], "risk": {"duration": {"assessment": "中短久期但含1-5年资产", "evidence": "合同要求非现金资产中剩余期限不超过3年的资产不低于80%；报告到期/重定价桶显示约69.85亿元在1-5年，不能据此直接得出精确久期。利率平移±25bp影响约±0.66%净资产。", "exact_years": null}, "leverage": {"assessment": "回购杠杆显著，是五只样本中期末最高", "asset_to_nav_pct": 126.78, "repo_financing_to_nav_pct": 26.03}, "credit_concentration": {"assessment": "债券占净资产125.41%，金融债50.73%、中票54.38%、企业债17.81%；前五大合计12.21%，多为银行二级资本债。报告未公开外部评级分布，因此信用质量未完成核验。", "top5_pct_nav": 12.21}, "equity_exposure": {"assessment": "合同不投资股票和权证，但允许投资ABS、国债期货及可分离交易可转债的纯债部分；2026-06-30期末未持有股票、可转债、ABS或衍生品。", "actual_pct": 0.0, "convertible_bond_exposure_pct": 0.0}}, "terms": {"minimum_holding_days": 0, "redemption_fee_note": "没有合同锁定期；不足7日赎回费1.50%，7-29日0.10%，满30日为0。", "settlement_note": "正常T日申请、T+1确认、T+2可查询；招募说明书规定赎回申请成功后T+7日（包括该日）内支付，巨额赎回等情形按合同处理。"}, "fit": {"suitable": ["能承受显著回购杠杆和信用利差波动、以中短信用债票息为目标的候选池", "愿意进一步补齐外部评级和逐券信用研究的专业投资者"], "unsuitable": ["现金替代、低杠杆或极低回撤需求", "无法接受银行二级资本债、产业中票和回购融资风险", "在外部评级分布未补齐前要求完整信用验证"]}, "unknowns": ["公开文件没有可复核的外部评级分布", "精确组合久期", "报告PDF不列1个月和24个月窗口；系统净值引擎结果不属于本档案PDF证据", "研究日销售平台可买性、申购限制、限额和实际到账时点", "2026年6月后杠杆与组合是否变化"], "source_documents": [{"kind": "report", "title": "华夏中短债债券型证券投资基金2026年第3季度报告", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202610271830986849_1.pdf", "sha256": "1e686a189a095759df0bfdd0401df1b99b40fb2ce88bfbce4a2703364a0564f7", "page_count": 20, "published_at": "2026-10-27", "source_role": "collected_material"}, {"kind": "key_information", "title": "华夏中短债债券型证券投资基金(华夏中短债债券A)基金产品资料概要更新(2026-05-29)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202605291822990183_1.pdf", "sha256": "8efb079a271ba45e396b71209e62f4120647f145b6f589a4033392f4c380befd", "page_count": 6, "published_at": "2026-05-29", "source_role": "collected_material"}, {"kind": "prospectus", "title": "华夏中短债债券型证券投资基金招募说明书更新(2026年5月29日公告)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202605291822991817_1.pdf", "sha256": "e331e7afc227098697a237fab1ad9b9674ab880cf9de7aa913fb6e538d56dcab", "page_count": 164, "published_at": "2026-05-29", "source_role": "collected_material"}]}, "assessment": {"share_id": "006668", "product_key": "mother:华夏中短债债券型证券投资基金", "official_mother_id": "华夏中短债债券型证券投资基金", "representative_share_id": "006668", "queue": "research_candidates", "base_gate_reasons": ["evidence_status_not_verified", "market_data_is_dated_requires_disclosure_calendar_review", "risk_verified_required"], "formal_eligible_horizons_months": []}, "holding_scenarios": {"windows": {"1": {"months": 1, "ready": false, "fee_status": "unknown", "net_return": null, "as_of": "2026-11-11", "fee_schedule_as_of": "2026-11-11", "market_data_end": "2026-11-10", "gate_reasons": ["current_fee_version_missing"], "standard_current_fee_scenario": {"status": "unknown", "net_return": null, "subscription_rate_pct": null, "redemption_rate_pct": null, "effective_from": null, "effec