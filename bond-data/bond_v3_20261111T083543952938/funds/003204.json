prehensive_annual_pct": 1.32, "redemption": [{"holding_days": "0-6", "rate_pct": 1.5}, {"holding_days": "7-29", "rate_pct": 0.1}, {"holding_days": "\u003e=30", "rate_pct": 0.0}]}, "fee_refs": [], "findings": [{"statement": "C类标准表截至2026-06-30过去3/6/12个月收益23.03%/26.90%/48.58%，同期基准0.62%/0.91%/-0.56%。", "pdf_page": 8, "source_sha256": "cf71f5f54d04a56c509c8eeee4a083dfc8988e635ba96fe47f7c3e391cef9bf5"}, {"statement": "管理人第13页把48.58%和-0.56%写成‘本报告期’，但它们实际对应第8页过去一年；本档案不采用该误述作为半年收益。", "pdf_page": 13, "source_sha256": "cf71f5f54d04a56c509c8eeee4a083dfc8988e635ba96fe47f7c3e391cef9bf5"}, {"statement": "期末股票15.12%、债券81.29%，债券中可转债/可交换债16.99%；资产/净资产103.03%，无回购融资。", "pdf_page": 50, "source_sha256": "cf71f5f54d04a56c509c8eeee4a083dfc8988e635ba96fe47f7c3e391cef9bf5"}, {"statement": "前五大债券合计16.17%，其中两只转债合计5.31%；期末无ABS。", "pdf_page": 50, "source_sha256": "cf71f5f54d04a56c509c8eeee4a083dfc8988e635ba96fe47f7c3e391cef9bf5"}, {"statement": "C类不收申购费，持有满30日赎回费为0；管理费0.70%、托管费0.20%、销售服务费0.40%。", "pdf_page": 4, "source_sha256": "719dc4a74d0bda633ad97e92e5f837bdf1db5bf5703ec88c7fb66cf07bea49f2"}], "return_sources": ["标准表显示C类上半年26.90%，同期中债综合指数0.91%；巨大差异主要来自股票和转债，而非单纯债券票息。", "期末股票15.12%、转债16.99%；经理称二季度增配科技方向，权益和转债择券是主要收益与波动来源。", "纯债部分以中短久期利率债和高评级信用债为底仓；期末无回购融资，杠杆不是当期主要来源。"], "risk": {"duration": {"assessment": "纯债部分中短久期，但组合整体受转债和股票主导", "evidence": "经理称纯债主要配置中短久期利率债和高评级信用债；利率平移±25bp影响净资产约±0.38%，但股票15.12%和转债16.99%带来更大市场波动。", "exact_years": null}, "leverage": {"assessment": "期末无回购融资，资产负债表仍有清算和赎回负债", "asset_to_nav_pct": 103.03, "repo_financing_to_nav_pct": 0.0}, "credit_concentration": {"assessment": "债券81.29%净资产，前五大债券合计16.17%，其中两只转债合计5.31%；信用债和转债需分别评估。", "top5_pct_nav": 16.17}, "equity_exposure": {"assessment": "典型二级债基：股票15.12%加转债16.99%形成显著权益敏感敞口；期末无ABS。", "actual_pct": 15.12, "convertible_bond_exposure_pct": 16.99}}, "terms": {"minimum_holding_days": 0, "redemption_fee_note": "没有合同锁定期；C类不足7日赎回费1.50%，7至29日0.10%，满30日为0。", "settlement_note": "正常T日申请、T+1确认、T+2可查询；赎回款在T+7日内支付，实际到账受渠道和银行清算影响。"}, "fit": {"s