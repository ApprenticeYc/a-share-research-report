ays": 0, "redemption_fee_note": "没有合同锁定期；不足7日赎回费1.50%，随后递减，持有满180日为0。", "settlement_note": "正常T日申请、T+1确认、T+2可查询；招募说明书规定赎回款在T+7日内支付，实际到账受销售渠道、银行清算及巨额赎回安排影响。"}, "fit": {"suitable": ["能承受转债、阶段性股票交易、较高回购融资与主动久期波动的固收增强需求", "计划持有至少180日并理解收益高度依赖资产配置的投资者"], "unsuitable": ["把债券基金等同纯债或低波动现金替代", "不能接受可转债、权益、信用集中和杠杆", "短期频繁赎回或要求本金保证"]}, "unknowns": ["精确组合久期未披露", "信用债逐券评级、行业集中度及转债正股穿透未完整披露，无法把较高杠杆下的信用与权益敏感性完全归因，因此作者状态保持partial", "中报不列1个月和24个月窗口", "研究日平台可买性、渠道折扣、限额和实际到账时点未核"], "source_documents": [{"kind": "report", "title": "华夏聚利债券型证券投资基金2026年中期报告", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202608311828780228_1.pdf", "sha256": "948f901060ab63325bda4df315930c4f3eb30567b08051c35fcce640a5f6e993", "page_count": 50, "published_at": "2026-08-31"}, {"kind": "key_information", "title": "华夏聚利债券型证券投资基金(华夏聚利债券A)基金产品资料概要更新(2026-05-29)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202605291822990453_1.pdf", "sha256": "15d69ff3461ee6a181b17373a6931951ecfb2207f9e3efa37723cc3cbe0c7a3a", "page_count": 6, "published_at": "2026-05-29"}, {"kind": "prospectus", "title": "华夏聚利债券型证券投资基金招募说明书更新(2026年5月29日公告)", "source_url": "https://pdf.dfcfw.com/pdf/H2_AN202605291822991773_1.pdf", "sha256": "152765be17bf3e8229d83f34654a2bd1d1f340ead5a1c51da67189679e9ad2bd", "page_count": 169, "published_at": "2026-05-29"}]}, "assessment": {"share_id": "000014", "product_key": "mother:华夏聚利债券型证券投资基金", "official_mother_id": "华夏聚利债券型证券投资基金", "representative_share_id": "000014", "queue": "research_candidates", "base_gate_reasons": ["evidence_status_not_verified"], "formal_eligible_horizons_months": []}, "holding_scenarios": {"windows": {"1": {"months": 1, "ready": false, "fee_status": "unknown", "net_return": null, "as_of": "2026-09-22", "fee_schedule_as_of": "2026-09-22", "market_data_end": "2026-09-22", "gate_reasons": ["current_fee_version_missing"], "standard_current_fee_scenario": {"status": "unknown", "net_return": null, "subscription_rate_pct": null, "redemption_rate_pct": null, "effective_from": null, "effect